# Server-side: where Next proxies /api to (the .NET backend).
# Docker: http://server:5000  |  local dev: http://localhost:5000
BACKEND_URL=http://localhost:5000

# Browser-side: the WebSocket endpoint the client connects to directly
# (token auth via query string). Must be reachable from the browser.
NEXT_PUBLIC_WS_URL=ws://localhost:5001
