# Copy this to .env and adjust. Compose auto-loads .env.
# .env is gitignored; this template is safe to commit.

# --- Postgres ---
POSTGRES_DB=rambler
POSTGRES_USER=rambler
POSTGRES_PASSWORD=rambler

# --- Server: database connection (points at the "db" service) ---
CONNECTION_STRING=Host=db;Port=5432;Database=rambler;User Id=rambler;Password=rambler;

# --- Server: auth token (JWT) ---
TOKEN_SECRET=change-me-dev-only-secret
TOKEN_EXPIRATION_MINUTES=1440

# --- Server: site / cookies ---
SITE_APP_URL=http://localhost:5000/#!
# empty domain -> host-only cookie (works for both localhost and 127.0.0.1)
SITE_COOKIE_DOMAIN=
# local http same-origin: Lax. For prod (https, split domain) use None + Always.
SITE_COOKIE_SAMESITE=Lax
SITE_COOKIE_SECURE=None
SITE_COOKIE_IDENTITY=rambler-identity
SITE_ENABLE_CAPTCHA=false
# Auto-confirm new users when no SMTP is configured, so local/dev without email works.
# MUST stay false in production: otherwise anyone can register accounts for emails they don't own.
SITE_AUTOCONFIRMEMAIL=true

# username that owns the auto-seeded default "Lobby" channel
SITE_LOBBY_OWNER=ByteSlinger

# --- Logging ---
LOG_LEVEL=Information

# --- Host port the .NET server (API + legacy client) is published on ---
APP_PORT=5000

# --- Next.js frontend ---
WEB_NEXT_PORT=5001
# WebSocket endpoint. Empty -> browser uses same-origin (:5001) and server.js
# proxies the ws upgrade to the backend. Set a value only to bypass the proxy.
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# --- MinIO (S3-compatible object storage for image uploads) ---
MINIO_ROOT_USER=rambler
MINIO_ROOT_PASSWORD=rambler-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# server talks to minio in the docker network; the browser loads images from the public URL
MEDIA_ENDPOINT=http://minio:9000
MEDIA_PUBLIC_URL=http://localhost:9000/rambler-media
MEDIA_BUCKET=rambler-media

# --- CORS (cross-origin access) ---
# true reflects ANY origin (valid with credentials) - convenient for local dev.
SITE_ALLOWANYORIGIN=true
# comma-separated allow-list for production (overrides AllowAnyOrigin when set)
SITE_CORSORIGINS=

# Blog / changelog issues (GitHub proxy). Token optional; raises rate limits and enables private repos.
BLOG_GITHUB_REPO=8labs/rambler
BLOG_GITHUB_TOKEN=
