# Copy this to .env and adjust. Compose auto-loads .env.
# .env is gitignored; this template is safe to commit.

# --- Postgres ---
POSTGRES_DB=rambler
POSTGRES_USER=rambler
POSTGRES_PASSWORD=rambler

# --- Server: database connection (points at the "db" service) ---
CONNECTION_STRING=Host=db;Port=5432;Database=rambler;User Id=rambler;Password=rambler;

# --- Server: auth token (JWT) ---
TOKEN_SECRET=change-me-dev-only-secret
TOKEN_EXPIRATION_MINUTES=1440

# --- Server: site / cookies ---
SITE_APP_URL=http://localhost:5000/#!
# empty domain -> host-only cookie (works for both localhost and 127.0.0.1)
SITE_COOKIE_DOMAIN=
# local http same-origin: Lax. For prod (https, split domain) use None + Always.
SITE_COOKIE_SAMESITE=Lax
SITE_COOKIE_SECURE=None
SITE_COOKIE_IDENTITY=rambler-identity
SITE_ENABLE_CAPTCHA=false

# username that owns the auto-seeded default "Lobby" channel
SITE_LOBBY_OWNER=ByteSlinger

# --- Logging ---
LOG_LEVEL=Information

# --- Host port the app is published on ---
APP_PORT=5000
